{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "pooja-pasal",
          "appId": "1:64467931721:android:2a04f68daa7e76dcae6598",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "pooja-pasal",
          "appId": "1:64467931721:ios:b45afe7c05dada7dae6598",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "pooja-pasal",
          "configurations": {
            "android": "1:64467931721:android:2a04f68daa7e76dcae6598",
            "ios": "1:64467931721:ios:b45afe7c05dada7dae6598"
          }
        }
      }
    }
  }
}
