rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Custom claims are set exclusively by trusted backend code (Cloud
    // Functions, using the Admin SDK, which bypasses these rules entirely):
    //   - functions/src/roles/onUserCreate.ts sets "buyer" or "seller" once,
    //     when the user's `users/{uid}` doc is first created.
    //   - functions/src/roles/setUserRole.ts (admin-only) and
    //     approveSellerApplication.ts are the only ways to change it after
    //     that, including the only way "admin" is ever granted.
    // A client can freely edit its own `users/{uid}.role` Firestore field
    // (see the `users` rule below, which blocks that), but it can never
    // touch `request.auth.token.role` — that only changes when the ID
    // token is reissued after a server-side custom-claims change. This is
    // what makes isAdmin()/isSeller() below trustworthy where a check
    // against resource.data.role would not be.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // True if this product's stock is being decreased by exactly the
    // quantity of a matching line item in an order that's being created
    // (in the same commit) by the caller as its buyer. This ties the
    // decrement to a real purchase instead of letting any signed-in user
    // drain a competitor's stock by writing to the product directly.
    //
    // NOTE: once functions/src/orders/createOrder.ts is deployed, order
    // creation should go through it instead (it re-validates price/stock
    // server-side and isn't limited to what a security rule can express).
    // This client-side transaction path is kept working in the meantime so
    // checkout doesn't break before that's deployed.
    function isReservedByOrder(productId, orderId) {
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let decrement = resource.data.stock - request.resource.data.stock;
      let expectedItem = {
        'productId': productId,
        'name': resource.data.name,
        'price': resource.data.price,
        'qty': decrement,
        'sellerId': resource.data.sellerId,
      };
      return decrement > 0 &&
        order.buyerId == request.auth.uid &&
        order.items.hasAny([expectedItem]);
    }

    // True if this product's stock is being increased by exactly the
    // quantity of a matching line item in an order that's being cancelled
    // (in the same commit) by the caller as its buyer. This ties the
    // restore to a real cancellation instead of letting any signed-in
    // user inflate a competitor's stock.
    function isRestoredByCancel(productId, orderId) {
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let increment = request.resource.data.stock - resource.data.stock;
      let expectedItem = {
        'productId': productId,
        'name': resource.data.name,
        'price': resource.data.price,
        'qty': increment,
        'sellerId': resource.data.sellerId,
      };
      return increment > 0 &&
        order.buyerId == request.auth.uid &&
        order.status == 'cancelled' &&
        order.items.hasAny([expectedItem]);
    }

    // users/{userId}
    //  - a user can read/create/update their own profile doc, EXCEPT the
    //    `role` field (and the audit fields that go with it), which can
    //    only ever be set by trusted backend code. This is the fix for the
    //    core vulnerability: previously a buyer could edit their own doc
    //    and set role: 'admin'.
    //  - on create, role may only be 'buyer' or 'seller' (never 'admin'),
    //    matching what onUserCreate.ts additionally enforces server-side.
    //  - admins can read any profile (needed for the admin user-management
    //    screen), but still can't grant themselves anything new this way —
    //    role changes still only happen through setUserRole.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['buyer', 'seller'];
      allow update: if isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'roleChangedAt', 'roleChangedBy']);
      allow delete: if false;
    }

    // categories/{categoryId} - public read of active categories, admin-only writes.
    match /categories/{categoryId} {
      allow read: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow write: if isAdmin();
    }

    // products/{productId}
    //  - any signed-in user can read active products
    //  - a seller can also read their own inactive/draft products
    //  - the owning seller (or an admin) can create/update/delete freely
    //  - any other signed-in user may update ONLY `stock` (+ the
    //    `lastOrderId` pointer it must be paired with), and only as a
    //    stock reservation/restore that's independently verified against
    //    a real order they own in the same commit (see the functions
    //    above) — never an arbitrary decrement/increment.
    //  - deletion is intentionally not allowed even for the owner once a
    //    product may be referenced by historical orders; use `isActive:
    //    false` instead. Sellers should stop exposing the delete action in
    //    the UI in favour of deactivation.
    match /products/{productId} {
      allow read: if isSignedIn() &&
        (resource.data.isActive == true || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId']) &&
         request.resource.data.stock is int &&
         request.resource.data.stock >= 0 &&
         request.resource.data.lastOrderId is string &&
         (isReservedByOrder(productId, request.resource.data.lastOrderId) ||
          isRestoredByCancel(productId, request.resource.data.lastOrderId)))
      );
      allow delete: if isAdmin();
    }

    // carts/{userId}/items/{productId} - a buyer can only read/write their own cart.
    match /carts/{userId}/items/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // users/{userId}/wishlist/{productId} - account-specific, synced wishlist.
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // users/{userId}/addresses/{addressId} - saved delivery addresses.
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // orders/{orderId}
    //  - a buyer can read and create their own orders
    //  - a seller can read orders that contain at least one of their products
    //  - admins can read/update any order (support/dispute handling)
    //  - a seller involved in the order may update its status, but only
    //    along the exact forward-fulfillment/cancel edges they're allowed
    //    to request (mirroring functions/src/orders/stateMachine.ts's
    //    isTransitionAllowedForRole for the seller role) — not to an
    //    arbitrary status from an arbitrary current status.
    //  - the buyer may cancel their own order, but only while it's still
    //    'pending' (before a seller has started fulfilling it)
    //
    // NOTE: functions/src/orders/{createOrder,updateOrderStatus}.ts remain
    // the preferred, authoritative path — they enforce the full state
    // machine (including 'returned'/'refunded', which this rule does not
    // open up to direct client writes at all) and write
    // statusHistory/paymentStatus consistently, which a direct write here
    // cannot. This rule enumerates the seller's allowed (from -> to) edges
    // explicitly, rather than only restricting the changed field, so a
    // direct Firestore write genuinely can't be used to bypass the Cloud
    // Function's transition/restocking logic — a seller can't jump straight
    // to 'delivered', set 'refunded' (admin-only), or cancel a shipped
    // order this way, matching what the app itself already exclusively
    // does by calling updateOrderStatus.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid ||
         request.auth.uid in resource.data.sellerIds ||
         isAdmin());

      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;

      allow update: if isAdmin() || (isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (
          (request.auth.uid in resource.data.sellerIds &&
           (
             (resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'cancelled']) ||
             (resource.data.status == 'confirmed' && request.resource.data.status in ['processing', 'cancelled']) ||
             (resource.data.status == 'processing' && request.resource.data.status in ['shipped', 'cancelled']) ||
             (resource.data.status == 'shipped' && request.resource.data.status == 'delivered')
           )) ||
          (request.auth.uid == resource.data.buyerId &&
           resource.data.status == 'pending' &&
           request.resource.data.status == 'cancelled')
        ));

      allow delete: if false;
    }

    // sellerApplications/{uid} - written only by trusted functions
    // (requestSellerUpgrade / approveSellerApplication / rejectSellerApplication),
    // which validate/dedupe applications and are the only path that can
    // grant the 'seller' custom claim after signup. Direct client writes
    // are denied so an applicant can't just set their own status to
    // 'approved'.
    match /sellerApplications/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // reviews/{reviewId} - public read; writes only via the createReview
    // Cloud Function (Admin SDK), which verifies the reviewer actually
    // bought and received the product before allowing it. Not expressible
    // safely as a security rule (requires reading a different buyer-owned
    // order document to authorize), so client writes are denied outright.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // notifications/{userId}/items/{notificationId}
    //  - only the owner can read, mark-read, or delete their own notifications
    //  - creation is restricted to either the owner themselves, or a
    //    signed-in user who is the buyer or a seller on the specific order
    //    the notification references — i.e. you can only notify someone
    //    else about an order you're actually part of, not an arbitrary
    //    user. This replaces an earlier rule that let any signed-in user
    //    write into any other user's notifications collection.
    //
    // NOTE: once functions/src/notifications/onOrderWrite.ts is deployed,
    // it becomes the sole writer of order notifications (Admin SDK,
    // bypasses this rule) and client-side notification creation for order
    // events should be removed from the app; this rule can then be
    // tightened to owner-only.
    match /notifications/{userId}/items/{notificationId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.orderId is string &&
         exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
         (
           get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerIds
         ))
      );
    }
  }
}
